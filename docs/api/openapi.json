{
  "openapi": "3.1.0",
  "info": {
    "title": "TicketFlow API",
    "version": "0.1.0",
    "description": "仅包含首批已实现接口。票务交易接口待后续模块实现。"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "注册普通用户",
        "tags": [
          "Identity"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "USERNAME_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "TEMPORARILY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "username": "example_user",
                "password": "ExampleOnly_123"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "登录",
        "tags": [
          "Identity"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / BAD_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "TEMPORARILY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "username": "example_user",
                "password": "ExampleOnly_123"
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "当前用户",
        "tags": [
          "Identity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / BAD_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "TEMPORARILY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "operationId": "health",
        "summary": "健康检查",
        "security": [],
        "responses": {
          "200": {
            "description": "健康",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "UP"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "健康检查未通过，Actuator原生响应"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{4,32}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "writeOnly": true,
            "description": "Unicode码点；不trim、不截断"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId",
          "replayed"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "userId",
              "username",
              "role"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "username": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "USER",
                  "ADMIN"
                ]
              }
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId",
          "replayed"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "accessToken",
              "tokenType",
              "expiresIn"
            ],
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "tokenType": {
                "type": "string",
                "const": "Bearer"
              },
              "expiresIn": {
                "type": "integer",
                "const": 1800
              }
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId",
          "replayed"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": [
              "object",
              "null"
            ]
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean",
            "const": false
          }
        }
      }
    }
  }
}